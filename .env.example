# Public origin used for Checkout return URLs and same-origin request validation.
STATECOURSE_BASE_URL=https://statecourse.com

# Stripe is test-only until the production activation checklist is completed.
STRIPE_MODE=test
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=
STATECOURSE_LIVE_PAYMENTS_ENABLED=false
STATECOURSE_SANDBOX_ALLOW_DRAFT_COURSES=false
STATECOURSE_STRIPE_AUTOMATIC_TAX_ENABLED=false

# Server-authoritative prices. Do not expose or accept a browser-supplied amount.
STATECOURSE_PRICE_ME_SALES_AGENT_TEST_CENTS=
STATECOURSE_PRICE_ME_SALES_AGENT_LIVE_CENTS=
STATECOURSE_PRICE_VA_SALESPERSON_TEST_CENTS=
STATECOURSE_PRICE_VA_SALESPERSON_LIVE_CENTS=
STATECOURSE_PRICE_WI_SALESPERSON_TEST_CENTS=
STATECOURSE_PRICE_WI_SALESPERSON_LIVE_CENTS=
STATECOURSE_PRICE_MO_PREEXAM_48_TEST_CENTS=
STATECOURSE_PRICE_MO_PREEXAM_48_LIVE_CENTS=
STATECOURSE_PRICE_MO_PRACTICE_24_TEST_CENTS=
STATECOURSE_PRICE_MO_PRACTICE_24_LIVE_CENTS=
STATECOURSE_PRICE_OK_BASIC_90_TEST_CENTS=
STATECOURSE_PRICE_OK_BASIC_90_LIVE_CENTS=
STATECOURSE_PRICE_CA_PRINCIPLES_45_TEST_CENTS=
STATECOURSE_PRICE_CA_PRINCIPLES_45_LIVE_CENTS=
STATECOURSE_PRICE_CA_PRACTICE_45_TEST_CENTS=
STATECOURSE_PRICE_CA_PRACTICE_45_LIVE_CENTS=
STATECOURSE_PRICE_CA_MORTGAGE_45_TEST_CENTS=
STATECOURSE_PRICE_CA_MORTGAGE_45_LIVE_CENTS=

# Course activation is controlled independently for every state product.
STATECOURSE_ME_SALES_AGENT_APPROVAL_STATUS=submission_draft
STATECOURSE_ME_SALES_AGENT_ENROLLMENT_ENABLED=false
STATECOURSE_VA_SALESPERSON_APPROVAL_STATUS=submission_draft
STATECOURSE_VA_SALESPERSON_ENROLLMENT_ENABLED=false
STATECOURSE_WI_SALESPERSON_APPROVAL_STATUS=submission_draft
STATECOURSE_WI_SALESPERSON_ENROLLMENT_ENABLED=false
STATECOURSE_MO_PREEXAM_48_APPROVAL_STATUS=submission_draft
STATECOURSE_MO_PREEXAM_48_ENROLLMENT_ENABLED=false
STATECOURSE_MO_PRACTICE_24_APPROVAL_STATUS=submission_draft
STATECOURSE_MO_PRACTICE_24_ENROLLMENT_ENABLED=false
STATECOURSE_OK_BASIC_90_APPROVAL_STATUS=submission_draft
STATECOURSE_OK_BASIC_90_ENROLLMENT_ENABLED=false
STATECOURSE_CA_PRINCIPLES_45_APPROVAL_STATUS=submission_draft
STATECOURSE_CA_PRINCIPLES_45_ENROLLMENT_ENABLED=false
STATECOURSE_CA_PRACTICE_45_APPROVAL_STATUS=submission_draft
STATECOURSE_CA_PRACTICE_45_ENROLLMENT_ENABLED=false
STATECOURSE_CA_MORTGAGE_45_APPROVAL_STATUS=submission_draft
STATECOURSE_CA_MORTGAGE_45_ENROLLMENT_ENABLED=false

# Supabase service credentials are server-only. Never use the service role in a browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Stream paid-course delivery. The signing JWK is a server secret.
# CLOUDFLARE_STREAM_VIDEO_MAP maps stable StateCourse asset keys to 32-character Stream UIDs.
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_JWK=
CLOUDFLARE_STREAM_VIDEO_MAP={}

# Long random value used only by server-side admin payment endpoints.
STATECOURSE_ADMIN_API_TOKEN=
