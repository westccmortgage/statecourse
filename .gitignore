# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/.netlify/
__pycache__/
/outputs/
/work/

# Review renders and handoff archives are reproducible local delivery artifacts.
/texas/tx-law-of-agency-30-v1/video-production/renders/*-test-*.mp4
/texas/tx-law-of-agency-30-v1/video-production/delivery/*.zip
/texas/tx-law-of-agency-30-v1/video-production/delivery/

# scratch drafts from parallel content-authoring agents (merged into config/ then deleted)
/california/video-production/.ca-block-drafts/
/.prins2-drafts/

# Generated at build time by scripts/generate-national-platform.mjs, which writes the
# 51 jurisdiction hubs, the California course routes, and the core service routes into
# public/statecourse/ before site/build.sh copies public/ into dist/. They are build
# output, not source: every build recreates them, and committing them would guarantee
# drift from the generator that produces them.
#
# The six hand-built state course pages under real-estate/*/pre-license/ remain tracked.
# .gitignore does not untrack files, so those are unaffected by the patterns below.
# See docs/california/phase-1-audit.md, Finding 5, for the unresolved question of the
# generator overwriting those committed pages on every build.
/public/statecourse/blog/
/public/statecourse/continuing-education/
/public/statecourse/courses/
/public/statecourse/exam-prep/
/public/statecourse/free-practice/
/public/statecourse/get-licensed/
/public/statecourse/mortgage/
/public/statecourse/my-statecourse/
/public/statecourse/resources/
/public/statecourse/state-requirements/
/public/statecourse/real-estate/*/index.html
# Program segments vary by state - "pre-license", "qualifying", and others - so this
# matches any program directory under a jurisdiction rather than naming each one.
/public/statecourse/real-estate/*/*/
/public/statecourse/data/free-practice-catalog.json

# Local-only export destination for scripts/export-california-source-temp.mjs.
# Never inside public/ or dist/ — see tests/no-answer-key-published.test.mjs
.local-export/

# Print-ready course volumes: 13 MB of generated PDFs, rebuilt by
# scripts/build-california-print-volume.mjs. The HTML is tracked; the PDFs are not.
california/print/*.pdf
