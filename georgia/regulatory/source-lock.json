      "expected": {"sha256": "52eb1a8bacbce4c1bfd4dcd70a6a3e836861ef17e33d1b6c21b6d61811801c9e", "bytes": 1474386, "minimumBytes": 1000000, "mimeTypes": ["application/pdf"], "magicHex": "25504446"},
      "manualVerification": {"status": "verified", "date": "2026-09-02", "method": "download, hash, and rule-level reading"},
      "materialClaims": [
        {"id": "ga-broker-certified-histories", "locator": "Rule 520-1-.04(3)(g)", "claim": "Certification is required from every real-estate licensing jurisdiction and must address examination, prelicense and continuing-education requirements, current good standing, and discipline.", "reliedOnBy": ["config/georgia/phase-zero.mjs", "georgia/submission/01-broker-reciprocity-runbook.md", "georgia/submission/06-owner-action-checklist.md"]},
        {"id": "ga-broker-criminal-history", "locator": "Rule 520-1-.04(7)", "claim": "The applicant provides a law-enforcement criminal-history report from the residence state issued no more than 60 days before filing, with FBI escalation if it shows another-jurisdiction record or cannot be obtained.", "reliedOnBy": ["config/georgia/phase-zero.mjs", "georgia/submission/01-broker-reciprocity-runbook.md", "georgia/submission/06-owner-action-checklist.md"]},
        {"id": "ga-current-rule-fees", "locator": "Rule 520-1-.04(1)(a)1, 2, and 6", "claim": "Current-rule arithmetic is $170 for an original individual, $200 for an original firm, and $200 for an original school or instructor; older forms conflict and must be confirmed before payment.", "reliedOnBy": ["config/georgia/phase-zero.mjs", "georgia/PHASE-0-REPORT.md", "georgia/submission/04-school-approval-map.md"]},
        {"id": "ga-instructor-renewal", "locator": "Rule 520-2-.03(6)", "claim": "Instructor renewal requires 60 instructional hours and 36 instructor-education hours, at least 12 of the 36 through GREC annual school/instructor meetings.", "reliedOnBy": ["config/georgia/phase-zero.mjs", "georgia/PHASE-0-REPORT.md", "georgia/submission/02-instructor-approval-map.md"]},
        {"id": "ga-school-operational-requirements", "locator": "Rules 520-2-.02(2), (6), and (8), and 520-2-.04(6)", "claim": "The school package includes media/equipment and learning-environment statements or documented applicability, and an approved school must offer a qualifying continuing-education course every calendar year in addition to its prelicense/postlicense offerings.", "reliedOnBy": ["config/georgia/phase-zero.mjs", "georgia/PHASE-0-REPORT.md", "georgia/submission/04-school-approval-map.md", "georgia/submission/06-owner-action-checklist.md"]},
        {"id": "ga-salesperson-course-core", "locator": "Rule 520-2-.04(4)(a) and (4)(c)", "claim": "The 75-hour salesperson course has 15 specified subject areas, ethics throughout, outside reading and extensive graded written work with student certification, and proficiency demonstrations in applied skills.", "reliedOnBy": ["config/georgia/phase-zero.mjs", "georgia/PHASE-0-REPORT.md", "georgia/submission/05-distance-course-approval-map.md"]},
        {"id": "ga-course-distance-method", "locator": "Rule 520-2-.04(9) and (10)", "claim": "A distance hour is 60 minutes and a computer-based methodology must be approved before development, with interactivity, mastery, remediation, time validation, instructor access, and records controls.", "reliedOnBy": ["config/georgia/phase-zero.mjs", "georgia/PHASE-0-REPORT.md", "georgia/submission/05-distance-course-approval-map.md"]},
        {"id": "ga-course-pilot", "locator": "Rule 520-2-.04(10)(c)", "claim": "The documented nine-person pilot includes at least three unlicensed people, three licensed salespersons or CAMs, and six non-educators, with varied computer and real-estate skill levels.", "reliedOnBy": ["config/georgia/phase-zero.mjs", "georgia/PHASE-0-REPORT.md", "georgia/submission/05-distance-course-approval-map.md"]},
        {"id": "ga-course-final-exam", "locator": "Rule 520-2-.04(11)(d)-(g)", "claim": "The examination-submission safe harbor covers only multiple-choice format, at least four choices, and at least 100 questions; two secure forms, the 13 fixed content buckets plus authorized additional matters, and proctoring are independent requirements.", "reliedOnBy": ["config/georgia/phase-zero.mjs", "georgia/PHASE-0-REPORT.md", "georgia/submission/05-distance-course-approval-map.md"]},
        {"id": "ga-out-of-state-course-credit", "locator": "Rule 520-2-.04(12)(d)", "claim": "GREC may recognize a corresponding course approved by another jurisdiction when hours are similar and delivery is consistent with Georgia standards; applicant-specific acceptance remains unconfirmed.", "reliedOnBy": ["config/georgia/phase-zero.mjs", "georgia/PHASE-0-REPORT.md", "georgia/submission/02-instructor-approval-map.md"]}
      ]
