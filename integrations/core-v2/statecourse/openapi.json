            }
          }
        }
      }
    },
    "/api/admin/core/background": {
      "x-internal": true,
      "post": {
        "operationId": "executeCapturedObservation",
        "description": "Server-to-server Netlify Background Function. Original bearer and staff proof are validated again, actor/org scope is server-owned and only a durably reserved request can be captured and atomically claimed. Never call this endpoint as a browser submission. Netlify replies 202 before worker authorization: that platform response is not permission, completion or a result.",
        "security": [
          {
            "statecourseBearer": [],
            "staffProof": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact configured HTTPS StateCourse origin."
          }
        ],
        "requestBody": {
          "required": true,
          "description": "At most 1024 bytes; no actor, tenant, token, SQL or snapshot fields.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "runId"
                ],
                "properties": {
                  "runId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Netlify platform delivery acknowledgment only. The worker rechecks current source authority and atomically claims captured -> running; retries cannot repeat running, interrupted or completed work. Read the authenticated run endpoint for results."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "statecourseBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "StateCourse Supabase JWT"
      },
      "staffProof": {
        "type": "apiKey",
        "in": "header",
        "name": "x-statecourse-staff-proof",
        "description": "Original 43-character HttpOnly exact-session MFA proof, forwarded only by the server bridge. Never browser storage or logs."
      },
      "statecourseAccessCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-sc_access"
      },
      "statecourseStaffCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-sc_staff"
      }
    },
    "schemas": {
      "Scope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "courseId",
          "enrollmentId"
        ],
        "properties": {
          "courseId": {
            "const": "ca-real-estate-principles-45"
          },
          "enrollmentId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Hash": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "Evidence": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "table",
          "key",
          "field",
          "value",
          "snapshotHash"
        ],
        "properties": {
          "table": {
            "type": "string",
            "enum": [
              "enrollments",
              "courses",
              "regulatory_course_versions",
              "access_grants",
              "lms_compliance_state",
              "lms_assignment_state",
              "lms_block_progress",
              "payment_enrollments",
              "payments",
              "console_course_releases",
              "console_course_reviews",
              "console_tasks",
              "console_task_events",
              "console_evidence_events",
              "console_review_findings"
            ]
          },
          "key": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "field": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "snapshotHash": {
            "$ref": "#/components/schemas/Hash"
          },
          "recordHash": {
            "$ref": "#/components/schemas/Hash"
          },
          "resultHash": {
            "$ref": "#/components/schemas/Hash"
          },
          "rowCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          }
        }
      },
      "Observation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidateId",
          "code",
          "explanation",
          "evidence",
          "verification",
          "acceptedClaimIds"
        ],
        "properties": {
          "candidateId": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          },
          "verification": {
            "enum": [
              "accepted",
              "needs_human_review"
            ]
          },
          "acceptedClaimIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractVersion",
          "scope",
          "snapshotHash",
          "capturedAt",
          "status",
          "observations",
          "limitations"
        ],
        "properties": {
          "contractVersion": {
            "const": "statecourse.readonly.1"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "snapshotHash": {
            "$ref": "#/components/schemas/Hash"
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "workflowId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "enum": [
              "no_observations",
              "verified_observations",
              "needs_human_review"
            ]
          },
          "observations": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "$ref": "#/components/schemas/Observation"
            }
          },
          "trace": {
            "type": "object",
            "description": "Existing Core V2 claim/assessment/attempt contracts. With createProviderRuntimeFactory these records and budget reservations are persisted by the existing Core PostgreSQL repository/ledger; snapshots/results live in the separate private Core store.",
            "required": [
              "workflowState",
              "claims",
              "assessments",
              "attempts"
            ],
            "properties": {
              "workflowState": {
                "type": "string"
              },
              "claims": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "assessments": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "attempts": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            },
            "additionalProperties": false
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "persistence": {
            "$ref": "#/components/schemas/Persistence"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "runId": {
            "type": "string",
            "format": "uuid",
            "description": "Present on uncertain background handoff after durable reservation. Poll this run; never automatically submit again."
          }
        }
      },
      "Event": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "recorded_at"
        ],
        "properties": {
          "kind": {
            "enum": [
              "reserved",
              "captured",
              "running",
              "completed",
              "interrupted"
            ]
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Persistence": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runId",
          "resultHash",
          "createdAt"
        ],
        "properties": {
          "runId": {
            "type": "string",
            "format": "uuid"
          },
          "resultHash": {
            "$ref": "#/components/schemas/Hash"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RunState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractVersion",
          "runId",
          "status",
          "events"
        ],
        "properties": {
          "contractVersion": {
            "const": "statecourse.readonly.1"
          },
          "runId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "enum": [
              "reserved",
              "captured",
              "running",
              "interrupted"
            ]
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          }
        }
      }
    }
  }
}
