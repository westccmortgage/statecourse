            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Mandatory when the durable result store is configured. Scoped to the authenticated actor and server-configured organization. Same key/scope returns the original stored result; a different scope conflicts. Pending/interrupted requests never automatically replay."
          }
        ],
        "requestBody": {
          "required": true,
          "description": "At most 1024 bytes. Authority, tenant and SQL are never accepted in the body.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Scope"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Point-in-time observations; inspect each verification status. no_observations is not a compliance or launch approval.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "202": {
            "description": "Durably reserved request accepted for background delivery; not proof of completion. Poll the scoped GET run endpoint. A 409 retry never resubmits pending or interrupted work.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/RunState"
                    },
                    {
                      "$ref": "#/components/schemas/Result"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON, unknown authority fields or unsupported scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
