{
  "openapi": "3.1.0",
  "info": {
    "title": "StateCourse Core V2 read-only observations",
    "version": "1.3.0",
    "description": "StateCourse read-only observation contract. Existing Netlify hosting exposes the cookie-authenticated bridge and a durable background handoff; deployment alone does not activate source access or provider spending. Original standalone synchronous mode is retained. Source operations remain read-only."
  },
  "paths": {
    "/v1/statecourse/observations": {
      "post": {
        "operationId": "explainEnrollmentObservations",
        "security": [
          {
            "statecourseBearer": [],
            "staffProof": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact configured StateCourse server origin; no CORS allowance."
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Mandatory when the durable result store is configured. Scoped to the authenticated actor and server-configured organization. Same key/scope returns the original stored result; a different scope conflicts. Pending/interrupted requests never automatically replay."
          }
        ],
        "requestBody": {
          "required": true,
          "description": "At most 1024 bytes. Authority, tenant and SQL are never accepted in the body.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Scope"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Point-in-time observations; inspect each verification status. no_observations is not a compliance or launch approval.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "202": {
            "description": "Durably reserved request accepted for background delivery; not proof of completion. Poll the scoped GET run endpoint. A 409 retry never resubmits pending or interrupted work.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/RunState"
                    },
                    {
                      "$ref": "#/components/schemas/Result"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON, unknown authority fields or unsupported scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer/proof",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Wrong origin, expired/revoked MFA/session, role or CA scope denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown route or enrollment outside the fixed course",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "POST required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency scope conflict or existing non-replayable reserved/running/interrupted run",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "runId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 1024 bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "application/json required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Incomplete bounded source or integrity/finding limit refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "One analysis already active in this process",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Disabled, independent executors unavailable, source/provider failure or reauthorization unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/statecourse/observations/{runId}": {
      "get": {
        "operationId": "getStoredObservation",
        "security": [
          {
            "statecourseBearer": [],
            "staffProof": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact configured StateCourse server origin; no CORS allowance."
          },
          {
            "in": "path",
            "name": "runId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "description": "Return the immutable stored result only to its original actor within the configured organization, after current StateCourse MFA/role/CA reauthorization. Does not recapture source data or call providers. Historical evidence is explicitly point-in-time.",
        "responses": {
          "200": {
            "description": "Point-in-time observations; inspect each verification status. no_observations is not a compliance or launch approval.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "202": {
            "description": "Run exists but has no completed result; no automatic retry is initiated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunState"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer/proof",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Wrong origin, expired/revoked MFA/session, role or CA scope denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown route or enrollment outside the fixed course",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Disabled, independent executors unavailable, source/provider failure or reauthorization unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
