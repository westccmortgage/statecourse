                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 1024 bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "application/json required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Incomplete bounded source or integrity/finding limit refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "One analysis already active in this process",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Disabled, independent executors unavailable, source/provider failure or reauthorization unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Same-origin cookie bridge. Original HttpOnly cookies only; browser-supplied Authorization and identity/proof headers are ignored. Origin is mandatory for GET and POST. No query parameters. Disabled by default; no production route installed."
      }
    },
    "/api/admin/core/observations/{runId}": {
      "get": {
        "operationId": "getStoredObservationThroughCookieBridge",
        "security": [
          {
            "statecourseAccessCookie": [],
            "statecourseStaffCookie": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact configured StateCourse server origin; no CORS allowance."
          },
          {
            "in": "path",
            "name": "runId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "description": "Same-origin cookie bridge. Original HttpOnly cookies only; browser-supplied Authorization and identity/proof headers are ignored. Origin is mandatory for GET and POST. No query parameters. Disabled by default; no production route installed.",
        "responses": {
          "200": {
            "description": "Point-in-time observations; inspect each verification status. no_observations is not a compliance or launch approval.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "202": {
            "description": "Run exists but has no completed result; no automatic retry is initiated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunState"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer/proof",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Wrong origin, expired/revoked MFA/session, role or CA scope denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown route or enrollment outside the fixed course",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Disabled, independent executors unavailable, source/provider failure or reauthorization unavailable",
            "content": {
